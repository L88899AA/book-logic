{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "input_hash", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result": {"oneOf": [{"$ref": "#/$defs/unit"}, {"$ref": "#/$defs/integration"}, {"$ref": "#/$defs/review"}]}
  },
  "$defs": {
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "agent_id", "policy_hash", "identity_assurance"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "identity_assurance": {"const": "host_declared_unverified"}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "artifact_id", "source_span_ids", "support_check", "omission_check", "limitation_check"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "source_span_ids": {"$ref": "#/$defs/strings"},
        "support_check": {"type": "string", "minLength": 1},
        "omission_check": {"type": "string", "minLength": 1},
        "limitation_check": {"type": "string", "minLength": 1}
      }
    },
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["extraction_id", "page", "start", "end", "quote", "supports"],
      "properties": {
        "extraction_id": {"type": "string"}, "page": {"type": "integer", "minimum": 1},
        "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}, "supports": {"type": "string", "minLength": 1}
      }
    },
    "material": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "title", "text", "attribution", "reasoning", "conditions", "counterpoints", "terms", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "type": {"enum": ["claim", "fact", "event", "case", "statistic", "definition", "counterexample"]},
        "title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1},
        "attribution": {"enum": ["source_statement", "author_interpretation", "quoted_opinion", "editor_inference"]},
        "reasoning": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["text", "attribution", "evidence_indices"],
          "properties": {"text": {"type": "string", "minLength": 1},
            "attribution": {"enum": ["source_statement", "author_interpretation", "quoted_opinion", "editor_inference"]},
            "evidence_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}
        }}, "conditions": {"$ref": "#/$defs/strings"},
        "counterpoints": {"$ref": "#/$defs/strings"}, "terms": {"$ref": "#/$defs/strings"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "summary", "coverage", "materials", "risks", "open_questions"],
      "properties": {
        "kind": {"const": "unit"}, "summary": {"type": "string", "minLength": 1},
        "execution": {"$ref": "#/$defs/execution"},
        "coverage": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["span_id", "disposition", "note"],
          "properties": {"span_id": {"type": "string"}, "disposition": {"enum": ["extracted", "background", "unreadable"]}, "note": {"type": "string", "minLength": 1}}
        }},
        "materials": {"type": "array", "items": {"$ref": "#/$defs/material"}},
        "risks": {"type": "array", "uniqueItems": true, "items": {"enum": ["numbers", "table", "cross_unit", "notes", "contradiction", "unreadable"]}},
        "open_questions": {"$ref": "#/$defs/strings"}
      }
    },
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "summary", "question", "input_ids", "claims", "connections", "topics", "resolved_questions", "unresolved"],
      "properties": {
        "kind": {"enum": ["chapter", "book"]}, "summary": {"type": "string", "minLength": 1},
        "execution": {"$ref": "#/$defs/execution"},
        "question": {"type": "string", "minLength": 1}, "input_ids": {"$ref": "#/$defs/strings"},
        "claims": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["text", "attribution", "material_ids"],
          "properties": {"text": {"type": "string", "minLength": 1}, "attribution": {"enum": ["source_statement", "author_interpretation", "quoted_opinion", "editor_inference"]}, "material_ids": {"allOf": [{"$ref": "#/$defs/strings"}], "minItems": 1}}
        }},
        "connections": {"$ref": "#/$defs/strings"},
        "topics": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["term", "material_ids"],
          "properties": {"term": {"type": "string", "minLength": 1}, "material_ids": {"allOf": [{"$ref": "#/$defs/strings"}], "minItems": 1}}
        }},
        "resolved_questions": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["task_id", "question", "answer", "material_ids"],
          "properties": {"task_id": {"type": "string"}, "question": {"type": "string"}, "answer": {"type": "string", "minLength": 1}, "material_ids": {"allOf": [{"$ref": "#/$defs/strings"}], "minItems": 1}}
        }},
        "unresolved": {"$ref": "#/$defs/strings"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "decision", "reviewed_task_ids", "findings", "notes"],
      "properties": {
        "kind": {"const": "review"}, "decision": {"enum": ["pass", "revise"]},
        "execution": {"$ref": "#/$defs/execution"},
        "audits": {"type": "array", "items": {"$ref": "#/$defs/audit"}},
        "reviewed_task_ids": {"$ref": "#/$defs/strings"},
        "findings": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["task_id", "message"],
          "properties": {"task_id": {"type": "string"}, "message": {"type": "string", "minLength": 1}}
        }},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
